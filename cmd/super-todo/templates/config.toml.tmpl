# Configuration

# General
# editor = {{printf "%q" .Editor}}

# CLI behavior
# interactive_default = {{.InteractiveDefault}}
# plain_text = false  # When true: output plain text confirmation messages and errors instead of styled output
# confirm_delete = {{.ConfirmDelete}}

# Settings
# shell = {{printf "%q" .Shell}}  # Options: bash, zsh, fish, nu
# index_folders = []  # Glob patterns to scan for projects (e.g. ["~/Projects/*"])
# ignore_folders = [{{range $index, $element := .IgnoreFolders}}{{if $index}}, {{end}}{{printf "%q" $element}}{{end}}]
# show_taskless = {{.ShowTaskless}}  # When false: hide projects that don't have any tasks
# fts_files = [{{range $index, $element := .FtsFiles}}{{if $index}}, {{end}}{{printf "%q" $element}}{{end}}]
# fts_features = [{{range $index, $element := .FtsFeatures}}{{if $index}}, {{end}}{{printf "%q" $element}}{{end}}]
# fts_tasks = [{{range $index, $element := .FtsTasks}}{{if $index}}, {{end}}{{printf "%q" $element}}{{end}}]
# fts_subtasks = [{{range $index, $element := .FtsSubtasks}}{{if $index}}, {{end}}{{printf "%q" $element}}{{end}}]
# todo_tokens = [{{range $index, $element := .TodoTokens}}{{if $index}}, {{end}}{{printf "%q" $element}}{{end}}]
# cache_interval = {{.CacheInterval}}
# sync_interval = {{.SyncInterval}}  # Seconds between project scans (default: 3600 = 1 hour). Set to 0 to always rescan.
# script_icons = {}

# Display
# home_icon = {{printf "%q" .HomeIcon}}  # Icon to represent home directory in list view
# default_sort_by = {{printf "%q" .DefaultSortBy}}  # Options: newest, oldest, a-z, z-a

# UI
# list_spacing options: compact, tight, space
# list_spacing = {{printf "%q" .ListSpacing}}

# Colors
# Colors support named, numeric, or hex values (ex: 7, 13, "#ff8800").
# headings = {{printf "%q" .Headings}}
# primary = {{printf "%q" .Primary}}
# secondary = {{printf "%q" .Secondary}}
# text = {{printf "%q" .Text}}
# text_highlight = {{printf "%q" .TextHighlight}}
# description_highlight = {{printf "%q" .DescriptionHighlight}}
# tags = {{printf "%q" .Tags}}
# flags = {{printf "%q" .Flags}}
# muted = {{printf "%q" .Muted}}
# border = {{printf "%q" .Border}}
# error = {{printf "%q" .Error}}
# success = {{printf "%q" .Success}}
# color_title = {{printf "%q" .ColorTitle}}
# color_highlight_border = {{printf "%q" .ColorHighlightBorder}}
# color_name = {{printf "%q" .ColorName}}
# color_highlight_name = {{printf "%q" .ColorHighlightName}}
# color_tasks = {{printf "%q" .ColorTasks}}
# color_progress_bg = {{printf "%q" .ColorProgressBg}}
# color_progress_fg = {{printf "%q" .ColorProgressFg}}
# color_highlight_progress_bg = {{printf "%q" .ColorHighlightProgressBg}}
# color_highlight_progress_fg = {{printf "%q" .ColorHighlightProgressFg}}
