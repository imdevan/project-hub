# Configuration

# General
# editor = {{printf "%q" .Editor}}

# Settings
# workspace_location = ""  # Workspace root: always indexed, and where `import` clones projects (e.g. "~/Projects")
# index_folders = []  # Additional glob patterns to scan for projects, indexed alongside workspace_location (e.g. ["~/work/*"])
# ignore_folders = [{{range $index, $element := .IgnoreFolders}}{{if $index}}, {{end}}{{printf "%q" $element}}{{end}}]
# show_taskless = {{.ShowTaskless}}  # When false: hide projects that don't have any tasks
# fts_files = [{{range $index, $element := .FtsFiles}}{{if $index}}, {{end}}{{printf "%q" $element}}{{end}}]
# fts_features = [{{range $index, $element := .FtsFeatures}}{{if $index}}, {{end}}{{printf "%q" $element}}{{end}}]
# fts_tasks = [{{range $index, $element := .FtsTasks}}{{if $index}}, {{end}}{{printf "%q" $element}}{{end}}]
# fts_subtasks = [{{range $index, $element := .FtsSubtasks}}{{if $index}}, {{end}}{{printf "%q" $element}}{{end}}]
# todo_tokens = [{{range $index, $element := .TodoTokens}}{{if $index}}, {{end}}{{printf "%q" $element}}{{end}}]
# open_with_tmux = {{.OpenWithTmux}}  # When true: opens project editor in a new tmux window named after the project
# parallel = {{.Parallel}}  # Repositories processed at once by `pull` and `import` (override with --jobs/-j)
# sync_interval = {{.SyncInterval}}  # Seconds between project scans (default: 3600 = 1 hour). Set to 0 to always rescan.

# Display
# home_icon = {{printf "%q" .HomeIcon}}  # Icon to represent home directory in list view
# default_sort_by = {{printf "%q" .DefaultSortBy}}  # Options: newest, oldest, a-z, z-a

# UI
# list_spacing options: compact, tight, space
# list_spacing = {{printf "%q" .ListSpacing}}

# Colors
# Colors support named, numeric, or hex values (ex: 7, 13, "#ff8800").
# [colors]
# headings = {{printf "%q" .Colors.Headings}}
# primary = {{printf "%q" .Colors.Primary}}
# secondary = {{printf "%q" .Colors.Secondary}}
# text = {{printf "%q" .Colors.Text}}
# text_highlight = {{printf "%q" .Colors.TextHighlight}}
# description_highlight = {{printf "%q" .Colors.DescriptionHighlight}}
# tags = {{printf "%q" .Colors.Tags}}
# flags = {{printf "%q" .Colors.Flags}}
# muted = {{printf "%q" .Colors.Muted}}
# border = {{printf "%q" .Colors.Border}}
# error = {{printf "%q" .Colors.Error}}
# success = {{printf "%q" .Colors.Success}}
# title = {{printf "%q" .Colors.Title}}
# highlight_border = {{printf "%q" .Colors.HighlightBorder}}
# name = {{printf "%q" .Colors.Name}}
# highlight_name = {{printf "%q" .Colors.HighlightName}}
# tasks = {{printf "%q" .Colors.Tasks}}
# progress_bg = {{printf "%q" .Colors.ProgressBg}}
# progress_fg = {{printf "%q" .Colors.ProgressFg}}
# highlight_progress_bg = {{printf "%q" .Colors.HighlightProgressBg}}
# highlight_progress_fg = {{printf "%q" .Colors.HighlightProgressFg}}
